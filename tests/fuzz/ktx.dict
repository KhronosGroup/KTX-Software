# libFuzzer dictionary for KTX and KTX2 files.

# File identifiers.
ktx1_identifier="\xABKTX 11\xBB\x0D\x0A\x1A\x0A"
ktx2_identifier="\xABKTX 20\xBB\x0D\x0A\x1A\x0A"
ktx1_endianness="\x01\x02\x03\x04"

# Key/value data keys defined by the KTX specifications.
kvd_orientation="KTXorientation"
kvd_writer="KTXwriter"
kvd_writer_sc_params="KTXwriterScParams"
kvd_swizzle="KTXswizzle"
kvd_gl_format="KTXglFormat"
kvd_dxgi_format="KTXdxgiFormat__"
kvd_metal_pixel_format="KTXmetalPixelFormat"
kvd_anim_data="KTXanimData"
kvd_astc_decode_mode="KTXastcDecodeMode"
kvd_cubemap_incomplete="KTXcubemapIncomplete"
orientation_rd="rd"
orientation_ruo="ruo"

# Supercompression schemes (u32): none, BasisLZ, Zstandard, ZLIB and
# UASTC HDR 6x6 Intermediate.
sc_none="\x00\x00\x00\x00"
sc_basis_lz="\x01\x00\x00\x00"
sc_zstd="\x02\x00\x00\x00"
sc_zlib="\x03\x00\x00\x00"
sc_uastc_hdr_6x6_intermediate="\x04\x00\x00\x00"

# Data format descriptor: basic block header (vendor 0, type 0, version 1.3)
# and the color models of khr_df_model_e.
dfd_basic_header="\x00\x00\x00\x00\x02\x00"
dfd_model_unspecified="\x00"
dfd_model_rgbsda="\x01"
dfd_model_yuvsda="\x02"
dfd_model_yiqsda="\x03"
dfd_model_labsda="\x04"
dfd_model_cmyka="\x05"
dfd_model_xyzw="\x06"
dfd_model_hsva_ang="\x07"
dfd_model_hsla_ang="\x08"
dfd_model_hsva_hex="\x09"
dfd_model_hsla_hex="\x0a"
dfd_model_ycgcoa="\x0b"
dfd_model_yccbccrc="\x0c"
dfd_model_ictcp="\x0d"
dfd_model_ciexyz="\x0e"
dfd_model_ciexyy="\x0f"
dfd_model_bc1a="\x80"
dfd_model_bc2="\x81"
dfd_model_bc3="\x82"
dfd_model_bc4="\x83"
dfd_model_bc5="\x84"
dfd_model_bc6h="\x85"
dfd_model_bc7="\x86"
dfd_model_etc1="\xa0"
dfd_model_etc2="\xa1"
dfd_model_astc="\xa2"
dfd_model_etc1s="\xa3"
dfd_model_pvrtc="\xa4"
dfd_model_pvrtc2="\xa5"
dfd_model_uastc_ldr_4x4="\xa6"
dfd_model_uastc_hdr_4x4="\xa7"
dfd_model_uastc_hdr_6x6="\xa8"

# Zstandard frame magic and a ZLIB header.
zstd_magic="\x28\xb5\x2f\xfd"
zlib_header="\x78\x9c"
